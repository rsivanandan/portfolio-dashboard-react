# LLM provider configuration (Samridhi AI features)

# Primary: Google Gemini via AI Studio — get a key at https://aistudio.google.com
# (free tier, no credit card required). Copy this file to .env and fill in.
GEMINI_API_KEY=

# Optional overrides — defaults target Gemini's OpenAI-compatible endpoint.
# Swap providers without touching code by setting these.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.6-flash